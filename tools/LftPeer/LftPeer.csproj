<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LanFileTransfer</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>LftPeer</AssemblyName>
  </PropertyGroup>

  <!--
    Windows 版アプリのプロトコル実装をそのままリンクして、
    Android 版との相互接続テスト用のピアとして使う。
  -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\..\LanFileTransfer\SecureChannel.cs" />
    <Compile Include="..\..\..\LanFileTransfer\TransferProtocol.cs" />
    <Compile Include="..\..\..\LanFileTransfer\FileTransferService.cs" />
    <Compile Include="..\..\..\LanFileTransfer\SafeFileStore.cs" />
  </ItemGroup>
</Project>
