<?xml version="1.0" encoding="utf-8"?>
<!-- 合言葉・送信履歴などの設定はバックアップ/端末間転送の対象外にする。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
